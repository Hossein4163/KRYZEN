# Runtime settings for the web UI services (jarvis + pc-bridge). Read by systemd via EnvironmentFile.
KRYZEN_WORKSPACE=/home/kry/Projects/devpilot
PC_BRIDGE_WORKSPACE=/home/kry/Projects/devpilot
PC_BRIDGE_HOST=172.22.0.1
PC_BRIDGE_PORT=8765
KRYZEN_BRIDGE_URL=http://172.22.0.1:8765
KRYZEN_COMPOSE_PROJECT=n8n
N8N_CONTAINER=n8n-n8n-1
KRYZEN_BRIDGE_UNIT=pc-bridge
KRYZEN_ENGINE_UNIT=jarvis
JARVIS_PORT=8770
PC_BRIDGE_ALLOW_AGY_ACCEPT_ALL=1
PC_BRIDGE_DISABLE_SANDBOX=1
SUDO_PASS=1
