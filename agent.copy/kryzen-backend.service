[Unit]
Description=K.R.Y.Z.E.N backend containers (n8n, sandbox, runners, SearXNG)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/mnt/bullshit/n8n
# Waits for the data drive, then starts the stack (docker.socket starts Docker on demand).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -f /mnt/bullshit/n8n/compose.yml ] && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/docker compose -p n8n up -d
Restart=on-failure
RestartSec=15
TimeoutStartSec=600

[Install]
WantedBy=default.target
