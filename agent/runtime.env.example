# Copy to agent/runtime.env and adjust. Read by jarvis/start.sh and the systemd unit. Never commit runtime.env.

# Where your projects live. Each top-level folder here is a project.
KRYZEN_WORKSPACE=/home/YOU/Projects/devpilot
PC_BRIDGE_WORKSPACE=/home/YOU/Projects/devpilot

# Where agent notes, skills and templates live (an Obsidian vault works). Created under <vault>/_DevPilot.
KRYZEN_VAULT=/home/YOU/Projects/devpilot

# Web UI port
JARVIS_PORT=8770

# Agent shell commands run inside a bubblewrap sandbox. Leave this at 0.
PC_BRIDGE_DISABLE_SANDBOX=0
