# Copy to agent/runtime.env and adjust non-secret settings only.
# Provide credentials through the service or process environment.

# Where your projects live. Each top-level folder here is a project.
KRYZEN_WORKSPACE=/home/YOU/Projects/devpilot
PC_BRIDGE_WORKSPACE=/home/YOU/Projects/devpilot

# Where agent notes, skills and templates live (an Obsidian vault works). Created under <vault>/_DevPilot.
KRYZEN_VAULT=/home/YOU/Projects/devpilot

# Web UI port
JARVIS_PORT=8780

# Sandbox networking is disabled by default.
# To enable, set JARVIS_ACCESS_TOKEN in the server process environment first.
KRYZEN_ALLOW_SANDBOX_NETWORK=0
