[Unit]
Description=PC Bridge for Antigravity Agents
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/home/kryazzy/Space/n8n/agent/runtime.env
WorkingDirectory=/home/kryazzy/Space/n8n/agent/bridge
ExecStart=/usr/bin/python3 /home/kryazzy/Space/n8n/agent/bridge/pc_bridge.py
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
