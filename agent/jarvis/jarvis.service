[Unit]
Description=Antigravity CLI Agent Studio Web UI (http://127.0.0.1:8770)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/home/kryazzy/Space/n8n/agent/runtime.env
WorkingDirectory=/home/kryazzy/Space/n8n/agent/jarvis
ExecStart=/usr/bin/python3 /home/kryazzy/Space/n8n/agent/jarvis/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
