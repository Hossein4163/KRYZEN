{
  "id": "DevPilotResume01",
  "name": "DevPilot Auto-Resume",
  "nodes": [
    {
      "id": "cea6e595-a1a4-44be-b555-7c9497657c30",
      "name": "Note: DevPilot Auto-Resume",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -360
      ],
      "parameters": {
        "content": "## DevPilot Auto-Resume\nRuns when a **published** DevPilot execution fails (e.g. a model timeout). It asks the bridge for retry budget (max 3 per 30 min), waits 60 s, then calls DevPilot with an **AUTO-RESUME** message so it reloads the project state from files and continues where it stopped.\n\nEditor (manual) runs don't trigger error workflows — for those just type *continue* in the chat.",
        "width": 560,
        "height": 300,
        "color": 1
      }
    },
    {
      "id": "4206b8e4-732b-48fb-a98f-ad4659c1500c",
      "name": "On DevPilot Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "5cd88d15-9ed5-48ab-9ff8-b0e1d5521511",
      "name": "Check Retry Budget",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.22.0.1:8765/autoresume/attempt",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "error",
              "value": "={{ $json.execution.error.message }}"
            },
            {
              "name": "workflow",
              "value": "={{ $json.workflow.name }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "pcBridgeAuth0001",
          "name": "PC Bridge Token"
        }
      },
      "notes": "max 3 resumes / 30 min",
      "notesInFlow": true
    },
    {
      "id": "ec9ce93e-25d9-4d0f-b795-5b16fb7d4b36",
      "name": "Budget Left?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "allow",
              "leftValue": "={{ $json.allow }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8117dffb-e100-4274-a79f-c045cf101ef4",
      "name": "Cool Down 60s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 60,
        "unit": "seconds"
      }
    },
    {
      "id": "0b3010b8-ce80-418d-9cab-e4bf02bffa3c",
      "name": "Budget Used Up",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        120
      ],
      "parameters": {},
      "notes": "Stop: retry budget used up",
      "notesInFlow": true
    },
    {
      "id": "a83f199a-852f-412a-ab3c-db8c7a6404ef",
      "name": "Build Resume Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg",
              "name": "chatInput",
              "type": "string",
              "value": "=AUTO-RESUME: the last DevPilot run on project \"{{ $('Check Retry Budget').item.json.project }}\" stopped with this error: {{ $('On DevPilot Error').item.json.execution.error.message }}. Call Resume Project, then continue from the saved next action. Do not redo finished work."
            },
            {
              "id": "sid",
              "name": "sessionId",
              "type": "string",
              "value": "=auto-resume-{{ $('Check Retry Budget').item.json.project }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "70e0aaee-4ffe-4a23-9ab2-ab621c83e846",
      "name": "Resume DevPilot",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "UHpLpx9tkH6AyFdc"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "notes": "continue in the background",
      "notesInFlow": true
    }
  ],
  "connections": {
    "On DevPilot Error": {
      "main": [
        [
          {
            "node": "Check Retry Budget",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Retry Budget": {
      "main": [
        [
          {
            "node": "Budget Left?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Budget Left?": {
      "main": [
        [
          {
            "node": "Cool Down 60s",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Budget Used Up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cool Down 60s": {
      "main": [
        [
          {
            "node": "Build Resume Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Resume Message": {
      "main": [
        [
          {
            "node": "Resume DevPilot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}