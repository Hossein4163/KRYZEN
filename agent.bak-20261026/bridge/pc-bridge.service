[Unit]
Description=PC Bridge for n8n DevPilot agents (sandboxed shell/files in ~/Projects)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/run/media/kry/Bull Shit/n8n/agent/bridge
ExecStart=/usr/bin/python3 -I "/run/media/kry/Bull Shit/n8n/agent/bridge/pc_bridge.py"
Environment=PC_BRIDGE_HOST=172.22.0.1
Environment=PC_BRIDGE_PORT=8765
Environment=PC_BRIDGE_WORKSPACE=%h/Projects/devpilot
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
# Binding fails until the n8n Docker network exists; keep retrying.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
